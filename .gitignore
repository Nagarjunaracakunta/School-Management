# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / React
node_modules/
frontend/build/
frontend/dist/
frontend/coverage/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
# terraform.tfvars is committed on purpose (non-secret, per-environment values).
# Secrets must NEVER go in tfvars; use *.auto.tfvars locally if you need throwaway values.
*.auto.tfvars
override.tf
override.tf.json

# Secrets and local config: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials
.aws/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Docker / tooling
.sonar/
.scannerwork/

# Local dev artifacts
.dev-keys/
*.db
.ruff_cache/

# Local database passwords generated by scripts/db/bootstrap.sh
.dev-secrets/

# Terraform bootstrap keeps its state locally, one file per account. It is small but must not be committed.
terraform/bootstrap/state/

# Zip files Terraform builds for Lambda functions
.build/

# Native end-to-end stack (scripts/e2e/native-stack.sh)
.venv-e2e/
.e2e/
