# Copy to .env.local for local development. Nothing here is secret: Vite embeds
# VITE_* values into the public JavaScript bundle, so NEVER put secrets in them.

# Leave unset in AWS: the browser calls /api/v1 on the same CloudFront domain.
# VITE_API_BASE_URL=/api/v1

# Local dev proxy targets (defaults shown)
# DEV_AUTH_URL=http://localhost:8001
# DEV_ADMISSION_URL=http://localhost:8002
# DEV_STUDENT_URL=http://localhost:8003
# DEV_FEE_URL=http://localhost:8004
# DEV_ATTENDANCE_URL=http://localhost:8005
# DEV_NOTIFICATION_URL=http://localhost:8006
