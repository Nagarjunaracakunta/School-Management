# Local development only. Real environments inject these from Kubernetes
# ConfigMaps (non-secret) and Secrets Manager (secret). Never commit a real .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Local shortcut: SQLite file. In AWS leave DATABASE_URL unset and use DB_* below.
DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true

# DB_HOST=...  DB_PORT=5432  DB_NAME=school  DB_USER=attendance_svc
# DB_PASSWORD comes from Secrets Manager, never from a file in Git

# Public key (PEM) used to verify JWTs issued by the Auth Service
JWT_PUBLIC_KEY_FILE=../../.dev-keys/jwt_public.pem
JWT_ISSUER=school-auth
JWT_AUDIENCE=school-api

STUDENT_SERVICE_URL=http://localhost:8003

ATTENDANCE_EDIT_WINDOW_DAYS=7

# Leave empty locally: events are written to the log instead of SQS
SQS_QUEUE_URL=
AWS_REGION=ap-south-1
