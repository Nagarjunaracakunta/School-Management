# Local development only. Real environments inject these from Kubernetes
# ConfigMaps (non-secret) and Secrets Manager (secret). Never commit a real .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true
# DB_HOST=...  DB_PORT=5432  DB_NAME=school  DB_USER=auth_svc
# DB_PASSWORD comes from Secrets Manager, never from a file in Git

# The PRIVATE signing key. Only this service ever holds it. In AWS it comes from Secrets Manager.
# Locally, `python scripts/dev_jwt.py admin` creates one at .dev-keys/jwt_private.pem.
JWT_PRIVATE_KEY_FILE=../../.dev-keys/jwt_private.pem
JWT_ISSUER=school-auth
JWT_AUDIENCE=school-api
ACCESS_TOKEN_TTL_MINUTES=30

# Brute-force protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# First administrator, created with:  python -m app.cli create-admin --email you@school.org --name "Your Name"
# The password is read from AUTH_ADMIN_PASSWORD or prompted. It is never a command-line argument.
