# Local development only. Real environments inject these from Kubernetes
# ConfigMaps (non-secret) and Secrets Manager (secret). Never commit a real .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true
# DB_HOST=...  DB_PORT=5432  DB_NAME=school  DB_USER=notification_svc
# DB_PASSWORD comes from Secrets Manager, never from a file in Git

JWT_PUBLIC_KEY_FILE=../../.dev-keys/jwt_public.pem
JWT_ISSUER=school-auth
JWT_AUDIENCE=school-api

# Worker only. Leave SNS_TOPIC_ARN empty to log "sent" messages instead of publishing them.
SQS_QUEUE_URL=
SNS_TOPIC_ARN=
AWS_REGION=ap-south-1
# Local AWS emulator (moto): AWS_ENDPOINT_URL=http://localhost:5000  AWS_ACCESS_KEY_ID=test  AWS_SECRET_ACCESS_KEY=test

MAX_DELIVERY_ATTEMPTS=3
