# Local development only. Real environments inject these from Kubernetes
# ConfigMaps (non-secret) and Secrets Manager (secret). Never commit a real .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true
# DB_HOST=...  DB_PORT=5432  DB_NAME=school  DB_USER=student_svc
# DB_PASSWORD comes from Secrets Manager, never from a file in Git

JWT_PUBLIC_KEY_FILE=../../.dev-keys/jwt_public.pem
JWT_ISSUER=school-auth
JWT_AUDIENCE=school-api

# Academic year used for "current class/section". Defaults to the April-March year if unset.
# CURRENT_ACADEMIC_YEAR=2026-27
