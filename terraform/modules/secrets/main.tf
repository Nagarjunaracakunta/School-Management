locals {
  # Two logins per service (decision D13): <svc>_migrator changes the tables, <svc>_svc only reads and writes rows.
  logins = {
    for pair in setproduct(sort(tolist(var.services)), ["app", "migrator"]) :
    "${pair[0]}_${pair[1]}" => {
      service  = pair[0]
      kind     = pair[1]
      username = pair[1] == "app" ? "${pair[0]}_svc" : "${pair[0]}_migrator"
    }
  }
}

# ---- database passwords -----------------------------------------------------------------------------------------
# The password is generated by an EPHEMERAL resource: it exists only in memory during the run and is never written to
# the Terraform state or the plan. It goes straight into Secrets Manager through a WRITE-ONLY argument (`_wo`), which
# Terraform also never stores. So the state file contains no database passwords at all.
ephemeral "random_password" "db" {
  for_each = local.logins

  length  = 32
  special = false # letters and digits only: safe in a URL or connection string without escaping
}

resource "aws_secretsmanager_secret" "db" {
  for_each = local.logins

  name                    = "${var.name_prefix}/db/${each.key}"
  description             = "PostgreSQL login ${each.value.username} for the ${each.value.service} service"
  kms_key_id              = var.kms_key_id
  recovery_window_in_days = var.recovery_window_days

  tags = merge(var.tags, { Service = each.value.service, Kind = each.value.kind })
}

resource "aws_secretsmanager_secret_version" "db" {
  for_each = local.logins

  secret_id = aws_secretsmanager_secret.db[each.key].id

  secret_string_wo = jsonencode({
    username = each.value.username
    password = ephemeral.random_password.db[each.key].result
    host     = var.db_host
    port     = var.db_port
    dbname   = var.db_name
  })
  # Terraform cannot compare a value it does not store, so it compares THIS number instead: a new number means
  # "write a fresh password". Nothing else changes the secret.
  secret_string_wo_version = var.credentials_version
}

# ---- token signing keys -------------------------------------------------------------------------------------------
# Only the empty containers are created here. The key itself is generated outside Terraform and put in with
# scripts/aws/put-jwt-key.sh, because anything Terraform creates passes through it. A private signing key should not.
resource "aws_secretsmanager_secret" "jwt_private" {
  name                    = "${var.name_prefix}/jwt/private-key"
  description             = "RS256 private key used by the Auth service to sign tokens. Populate with scripts/aws/put-jwt-key.sh"
  kms_key_id              = var.kms_key_id
  recovery_window_in_days = var.recovery_window_days

  tags = var.tags
}

resource "aws_secretsmanager_secret" "jwt_public" {
  name                    = "${var.name_prefix}/jwt/public-key"
  description             = "The matching public key; every service uses it to verify tokens. Populate with scripts/aws/put-jwt-key.sh"
  kms_key_id              = var.kms_key_id
  recovery_window_in_days = var.recovery_window_days

  tags = var.tags
}
